{
  "name": "ludoteca",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-store game library viewer for Steam, GOG and Epic.",
  "author": "Eduard Dubau",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12"
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @ludoteca/core && npm run build -w @ludoteca/ui",
    "dev:electron": "npm run dev -w @ludoteca/electron",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "predev": "npm run build -w @ludoteca/core",
    "dev": "concurrently -k -n core,ui,electron -c magenta,cyan,yellow \"npm run dev -w @ludoteca/core\" \"npm run dev -w @ludoteca/ui\" \"npm run dev -w @ludoteca/electron\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "@electron/asar": "^4.3.0",
    "temp": {
      "rimraf": "^6.1.3"
    }
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false
  }
}
